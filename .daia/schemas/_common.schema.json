{
  "$id": "daia-e/common",
  "title": "Definições comuns",
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}-[A-Za-z0-9_-]{1,40}$",
      "description": "Identificador com prefixo de tipo, ex.: BD-supervisao, RNF-latencia"
    },
    "idRef": { "type": "string", "pattern": "^[A-Z]{2,4}-[A-Za-z0-9_-]{1,40}$" },
    "idRefList": { "type": "array", "items": { "$ref": "#/definitions/idRef" } },
    "sprint": { "type": "string", "enum": ["SP1", "SP2", "SP3", "SP4", "SP5"] },
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "provenance": {
      "type": "object",
      "description": "Quem produziu o artefato. A IA pode redigir; a assinatura da baseline é humana (Art. II).",
      "properties": {
        "drafted_by": { "type": "string", "enum": ["human", "ai", "ai-assisted"] },
        "model": { "type": "string" },
        "reviewed_by": { "type": "string" }
      },
      "required": ["drafted_by"]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "proposed", "accepted", "recovered", "superseded"],
      "description": "recovered = reconstruído de código existente, ainda não confirmado por humano"
    }
  }
}
